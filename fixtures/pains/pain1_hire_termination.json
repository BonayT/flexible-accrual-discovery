{
  "title": "Pain #1 — Italy: Hire date after 15th = 0 accrual for hire month",
  "program": {
    "params": {
      "monthly_base": 2.1667
    },
    "rule": {
      "type": "accrue",
      "amount": {
        "type": "case",
        "branches": [
          {
            "when": {
              "type": "lt",
              "left": {
                "type": "ref",
                "path": "period.year_month"
              },
              "right": {
                "type": "ref",
                "path": "facts.hire_date.year_month"
              }
            },
            "then": {
              "type": "const",
              "value": 0
            }
          },
          {
            "when": {
              "type": "and",
              "operands": [
                {
                  "type": "eq",
                  "left": {
                    "type": "ref",
                    "path": "period.year_month"
                  },
                  "right": {
                    "type": "ref",
                    "path": "facts.hire_date.year_month"
                  }
                },
                {
                  "type": "gt",
                  "left": {
                    "type": "ref",
                    "path": "facts.hire_date.day"
                  },
                  "right": {
                    "type": "const",
                    "value": 15
                  }
                }
              ]
            },
            "then": {
              "type": "const",
              "value": 0
            }
          }
        ],
        "else": {
          "type": "param",
          "name": "monthly_base"
        }
      }
    }
  },
  "scenario": {
    "label": "Luca Verdi",
    "range": [
      "2026-01",
      "2026-12"
    ],
    "facts": {
      "hire_date": "2026-03-20",
      "country": "IT",
      "children_count": 0,
      "gender": "male"
    },
    "by_month": {
    }
  }
}